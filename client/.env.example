# ── ShriMaruti.com Frontend Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in your values.
# For production on Render, set these as Environment Variables in the Render dashboard.
# DO NOT commit .env.local to version control.

# ── Backend API URL ─────────────────────────────────────────────────────────
# In development: leave empty (Vite proxy will forward /api → localhost:5000)
# In production: set to your Render backend URL
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api

# ── Google OAuth (Client ID — not a secret, safe for frontend) ──────────────
VITE_GOOGLE_CLIENT_ID=<ADD YOUR GOOGLE OAUTH CLIENT ID>

# ── Google Maps (Optional — for location/map features) ──────────────────────
VITE_GOOGLE_MAPS_KEY=<ADD YOUR GOOGLE MAPS API KEY>
