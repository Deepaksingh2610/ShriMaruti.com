PORT=5000
NODE_ENV=development

# ── Frontend URL ─────────────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production (Render): https://YOUR-RENDER-FRONTEND.onrender.com
CLIENT_URL=http://localhost:5173

# ── MongoDB Atlas Connection String ──────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ganeshgifting?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate a secure random string (min 64 chars recommended)
JWT_SECRET=<ADD YOUR JWT SECRET>
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=<ADD YOUR REFRESH TOKEN SECRET>
REFRESH_TOKEN_EXPIRE=7d

# ── Admin Credentials (Auto-seeded on first startup) ─────────────────────────
ADMIN_EMAIL=admin@shrimaruti.com
ADMIN_PASSWORD=<ADD A STRONG ADMIN PASSWORD>

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → API Keys
RAZORPAY_KEY_ID=<ADD YOUR RAZORPAY KEY ID>
RAZORPAY_KEY_SECRET=<ADD YOUR RAZORPAY KEY SECRET>
RAZORPAY_WEBHOOK_SECRET=<ADD YOUR RAZORPAY WEBHOOK SECRET>

# ── Cloudinary (Image Storage & CDN) ─────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<ADD YOUR CLOUDINARY CLOUD NAME>
CLOUDINARY_API_KEY=<ADD YOUR CLOUDINARY API KEY>
CLOUDINARY_API_SECRET=<ADD YOUR CLOUDINARY API SECRET>

# ── SMTP Email (Nodemailer) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<ADD YOUR GMAIL ADDRESS>
SMTP_PASS=<ADD YOUR GMAIL APP PASSWORD>
FROM_EMAIL=noreply@shrimaruti.com
FROM_NAME=Shri Maruti Support

# ── Brevo (Transactional Email & OTP) ────────────────────────────────────────
# Get from: https://app.brevo.com → API Keys
BREVO_API_KEY=<ADD YOUR BREVO API KEY>
BREVO_SENDER_EMAIL=<ADD YOUR VERIFIED BREVO SENDER EMAIL>
BREVO_SENDER_NAME=ShriMaruti
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=<ADD YOUR GOOGLE CLIENT ID>
GOOGLE_CLIENT_SECRET=<ADD YOUR GOOGLE CLIENT SECRET>
